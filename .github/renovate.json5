{
	// Renovate keeps the crates and action pins here current, in place of
	// Dependabot's version updates, and raises the security fixes too;
	// Dependabot's own security pull requests are switched off in the
	// repository settings, and its ALERTS stay on.
	//
	// Almost everything comes from the shared preset, xiphux/renovate-config:
	// the cooldowns, the auto-merge policy, the weekly timetable and its
	// groups, lockfile maintenance and the vulnerability alerts, each with its
	// rationale beside it. What follows is only what differs here. This file's
	// packageRules (it has none yet) are appended after the preset's, and
	// later rules win.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: ['github>xiphux/renovate-config:default.json5'],

	// Deliberately small. Actions minutes are free on a public repository, so
	// unlike the private repos this is not a billing decision: it bounds how
	// many open PRs a single merge invalidates, since `rebaseWhen:
	// 'behind-base-branch'` rebases every one left behind and each rebase
	// re-runs CI. Kept in line with the private repositories, where the same
	// number is a direct saving, so the configs stay comparable. Not a
	// throughput cap: prHourlyLimit (2, the default) limits creation well below
	// it. Majors are what to watch, since one nobody merges holds its slot
	// indefinitely.
	prConcurrentLimit: 5,

	// `deps:` for crates and the preset's `ci:` for actions, as Dependabot
	// wrote them.
	commitMessagePrefix: 'deps:',

	// Not yet: the preset turns on weekly lock file maintenance, which this
	// repository never had. Cargo.lock moves only with the update that needs
	// it, as before the shared preset. Drop this to take the Monday slot.
	lockFileMaintenance: {
		enabled: false,
	},

	// Cargo.toml is left alone wherever possible. Renovate's rangeStrategy
	// defaults to `auto`, which for cargo means `update-lockfile` unless a
	// "less than" constraint is present -- so a routine upgrade edits Cargo.lock
	// and not the manifest. That suits a binary crate: the manifest states the
	// minimum supported version, and the lockfile states what ships.
}
