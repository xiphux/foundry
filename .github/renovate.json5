{
	// Renovate keeps the crates and action pins here current, in place of
	// Dependabot's version updates. Dependabot's SECURITY updates stay on: they
	// are a repository setting rather than a config file, so a vulnerable crate
	// still arrives as a dependabot/** PR.
	//
	// Why the switch: Dependabot offers only a crate's newest version, so a
	// pending major replaced that crate's minor and patch updates -- hence
	// majors were ignored here, with major-upgrade-check.yml opening an issue
	// for each instead. It also rebases a PR only when it CONFLICTS, never when
	// it merely falls behind, so a batch stalled after its first merge and each
	// remaining PR needed a human to ask for a rebase. Renovate raises a major
	// and a minor together, and rebases whatever falls behind.
	//
	// Updates arrive on a weekly timetable rather than as they are released:
	// see `schedule` below and the groups in packageRules.
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: ['config:recommended'],

	// Rebase whenever a branch falls behind main, not only when it conflicts.
	// This is the behaviour the switch was made for.
	rebaseWhen: 'behind-base-branch',

	// Hold back fresh releases: a hijacked crates.io publish is usually found
	// and yanked within days, and most of these merge unattended. Three days
	// for a patch, as the Dependabot cooldown had it.
	minimumReleaseAge: '7 days',

	dependencyDashboard: true,

	// Deliberately small. Actions minutes are free on a public repository, so
	// unlike the private repos this is not a billing decision: it bounds how
	// many open PRs a single merge invalidates, since `rebaseWhen:
	// 'behind-base-branch'` rebases every one left behind and each rebase
	// re-runs CI. Kept in line with the private repositories, where the same
	// number is a direct saving, so the configs stay comparable. Not a
	// throughput cap: prHourlyLimit (2, the default) limits creation well below
	// it. Majors are what to watch, since one nobody merges holds its slot
	// indefinitely.
	prConcurrentLimit: 5,

	// The weekly timetable, and the slot for anything the groups in
	// packageRules do not claim: Sunday, 00:00-05:59 UTC. Each group has a day
	// of its own --
	//
	//   Mon  lock file maintenance     Thu  test and build
	//   Tue  aws                       Fri  production dependencies
	//   Wed  lint and format           Sat  github actions
	//   Sun  everything else: majors, 0.x packages, pnpm, images
	//
	// -- the same days in every repository that has the group. This is where
	// the CI minutes go: before it, every release that cleared the cooldown
	// was a pull request of its own, and the AWS SDK, which publishes almost
	// daily, opened ten to twelve in 19 days in each repository using it.
	// Replayed against ten days of real updates, this timetable raises about
	// 60% fewer pull requests, and every one saved is a CI run (and, where
	// the default branch deploys, a deploy).
	//
	// A day per group rather than one weekly slot for all of them, because of
	// the up-to-date rule in branch protection: open together, every merge
	// would put the others behind and re-run their CI, so six pull requests
	// would cost 6+5+4+3+2+1 runs. Spread out, one is usually open at a time.
	//
	// Six hours, because Mend's free plan runs Renovate about every four, so a
	// slot always holds a run. Wider would let more runs fall in it, and each
	// can open another pull request for releases that aged in the meantime.
	// Outside its slot a branch is still rebased and updated
	// (`updateNotScheduled`), so nothing already open waits for next week. To
	// take something early, tick it under "Awaiting Schedule" on the
	// dependency dashboard.
	//
	// Nothing hurries Renovate between its runs any more. A workflow used to
	// wake it after every merge so the next pull request rebased in minutes
	// rather than hours; with one or two open a week, hours are fine.
	schedule: ['* 0-5 * * 0'],

	automergeStrategy: 'merge',
	// GitHub's own auto-merge, so a PR lands the moment its checks pass. This
	// is a public repository, so branch protection with required checks is
	// available and is what makes that meaningful; without required checks
	// GitHub declines to arm it and Renovate merges during its own run instead.
	platformAutomerge: true,

	// `deps:` for crates and `ci:` for actions, as Dependabot wrote them.
	commitMessagePrefix: 'deps:',

	// The label Dependabot applied by default, kept so a saved PR filter still
	// finds these.
	labels: ['dependencies'],

	// Cargo.toml is left alone wherever possible. Renovate's rangeStrategy
	// defaults to `auto`, which for cargo means `update-lockfile` unless a
	// "less than" constraint is present -- so a routine upgrade edits Cargo.lock
	// and not the manifest. That suits a binary crate: the manifest states the
	// minimum supported version, and the lockfile states what ships.

	packageRules: [
		{
			matchManagers: ['github-actions'],
			commitMessagePrefix: 'ci:',
			// A hijacked action tag is usually caught and pulled within days; a
			// week keeps a fresh compromise from reaching a pin automatically.
			minimumReleaseAge: '7 days',
		},
		{
			matchUpdateTypes: ['patch'],
			minimumReleaseAge: '3 days',
		},

		// What auto-merges, and what does not. Carried over from the verdict in
		// dependabot-automerge.yml: patch yes; minor yes unless the crate is
		// 0.x; majors, prereleases and anything unrecognised never.
		{
			// A 0.0.x patch rides along with the rest. Semver promises nothing
			// there -- any release may break -- but CI is the gate that matters
			// here, and it covers those packages like any other. Hold one by
			// name if that ever stops being true.
			matchUpdateTypes: ['patch', 'minor'],
			automerge: true,
		},
		{
			// A 0.x crate's minor is its breaking release -- Cargo reads `0.11`
			// as >=0.11.0 <0.12.0, so 0.11 -> 0.12 is incompatible even though
			// semver calls it a minor. sha2 (0.11) and chrono (0.4) are both in
			// that position today. Held whether Renovate classifies the update
			// as minor or major, since majors are held below too.
			matchUpdateTypes: ['minor'],
			matchCurrentVersion: '/^0\\./',
			automerge: false,
		},
		{
			// Majors arrive as their own pull requests now, alongside that
			// crate's routine updates rather than in place of them, which is
			// what major-upgrade-check.yml's issues stood in for.
			matchUpdateTypes: ['major'],
		// Rebased only on a genuine conflict, unlike everything else here.
		// A major never auto-merges, so it sits open until somebody decides on
		// it -- and under the repository-wide `rebaseWhen: 'behind-base-branch'`
		// every unrelated merge to the default branch rebased it and re-ran the
		// whole suite against a pull request that was never going to land on
		// that push. Measured in heatsheet-io over 18-20 September: 44 of its
		// 54 pull-request CI runs were on majors, renovate/pnpm-12.x alone
		// running twelve times at roughly 51 billable minutes each.
		//
		// Being behind costs a major nothing: nothing merges it automatically,
		// and whoever picks it up wants a fresh run at that moment anyway --
		// which ticking its checkbox on the dependency dashboard provides.
		rebaseWhen: 'conflicted',
			automerge: false,
		},
		{
			matchCurrentVersion: '/-/',
			automerge: false,
		},

		// The groups, each in its slot in the timetable (see `schedule`). Later
		// rules win, so the ones matching by name take packages out of the two
		// that match by dependency type. Lists are the same in every repository,
		// names it does not use included, so a package lands in the same group
		// wherever it turns up.
		//
		// Every group leaves out 0.x packages (the negated matchCurrentVersion).
		// A 0.x minor does not auto-merge (see above), and a group auto-merges
		// only if every update in it does, so one would hold its whole group
		// open; left out, a 0.x package raises its own pull request on Sunday.
		//
		// The cost of batching: an update that fails CI holds the rest of its
		// group until it is fixed, or excluded by a rule of its own. Majors are
		// never grouped, and a security fix ignores all of this -- Renovate
		// applies `vulnerabilityAlerts` after these rules, and with `force`.
		{
			groupName: 'production dependencies',
			// npm and Cargo; pep621.
			matchDepTypes: ['dependencies', 'project.dependencies'],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 5'],
		},
		{
			groupName: 'test and build',
			// npm; Cargo; pep621's [dependency-groups], extras and build backend.
			matchDepTypes: [
				'devDependencies',
				'dev-dependencies',
				'build-dependencies',
				'dependency-groups',
				'project.optional-dependencies',
				'build-system.requires',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 4'],
		},
		{
			groupName: 'lint and format',
			matchPackageNames: [
				'eslint',
				'eslint-*',
				'@eslint/**',
				'@*/eslint-*',
				'typescript-eslint',
				'@typescript-eslint/**',
				'globals',
				'prettier',
				'prettier-*',
				'knip',
				'lint-staged',
				'husky',
				'publint',
				'ruff',
				'deptry',
				'pre-commit',
				'pre-commit/pre-commit-hooks',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 3'],
		},
		{
			groupName: 'aws',
			matchPackageNames: [
				'@aws-sdk/**',
				'aws-cdk',
				'aws-cdk-lib',
				'cdk-nag',
				'aws-xray-sdk-core',
				'@types/aws-lambda',
				'aws-ses-v2-local',
				'amazon/dynamodb-local',
				'boto3',
				'botocore',
			],
			matchUpdateTypes: ['minor', 'patch'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 2'],
		},
		{
			groupName: 'github actions',
			matchManagers: ['github-actions'],
			matchUpdateTypes: ['minor', 'patch', 'digest'],
			matchCurrentVersion: '!/^v?0\\./',
			schedule: ['* 0-5 * * 6'],
		},
		{
			// zizmor-action runs only zizmor versions it knows, and the version it
			// runs (its `version:` input, tracked as the zizmor image) is in the
			// group above. The action is 0.x, so the exclusion would send it to
			// Sunday, a day after a version it may not know yet, so it is kept
			// with the group.
			groupName: 'github actions',
			matchPackageNames: ['zizmorcore/zizmor-action'],
			matchUpdateTypes: ['minor', 'patch', 'digest'],
			schedule: ['* 0-5 * * 6'],
		},
	],

	// Renovate's own vulnerability source, from osv.dev, rather than the
	// GitHub alerts that `vulnerabilityAlerts` below reads. Both are wanted.
	//
	// `vulnerabilityAlerts` is `supportedPlatforms: ["github"]` -- it consumes
	// the Dependabot ALERTS on this repository, which means it works only if
	// the Renovate app can read them. That permission has not been confirmed
	// here, and the failure would be silent: no alerts visible, no fix raised,
	// nothing red. osv.dev is queried by Renovate directly, so this path does
	// not depend on it. osv.dev ingests GitHub's advisories among other
	// sources, so turning it on does not narrow what gets caught.
	//
	// This is what makes it safe to stop Dependabot opening its own security
	// pull requests: with a source Renovate owns, switching those off removes a
	// duplicate rather than the only fix. Dependabot ALERTS stay on -- they
	// cost nothing, and they feed `vulnerabilityAlerts` if that permission does
	// turn out to exist.
	//
	// Container images are not in scope here; Grype covers those.
	osvVulnerabilityAlerts: true,

	// A vulnerable crate is proposed regardless of the cooldown above, the same
	// carve-out Dependabot's security updates have.
	vulnerabilityAlerts: {
		minimumReleaseAge: null,
		automerge: false,
	},
}
